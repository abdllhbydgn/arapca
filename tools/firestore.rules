rules_version = '2';
// Arapça Öğren — Firestore güvenlik kuralları
// Firebase konsolu → Firestore Database → Kurallar sekmesine olduğu gibi yapıştırıp "Yayınla"ya basın.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    // Admin: yalnız Google ile doğrulanmış bu e-posta
    function isAdmin() { return signedIn() && request.auth.token.email == 'baydogan.sevtap@gmail.com' && request.auth.token.email_verified == true; }
    function isMe(uid) { return signedIn() && request.auth.uid == uid; }
    function approved() { return signedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'approved'; }

    // Üye profilleri: herkes yalnız kendini görür; durum ve rolü yalnız admin değiştirir
    match /users/{uid} {
      allow read: if isMe(uid) || isAdmin();
      allow create: if isAdmin() || (isMe(uid) && request.resource.data.status == 'pending' && request.resource.data.role == 'member');
      allow update: if isAdmin() || (isMe(uid) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['status', 'role', 'email']));
      allow delete: if isAdmin();
    }
    // İlerleme: yalnız onaylı üyenin kendisi ve admin
    match /progress/{uid} {
      allow read, write: if (isMe(uid) && approved()) || isAdmin();
    }
    // Site ayarları (duyuru): herkes okur, yalnız admin yazar
    match /site/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }
    // Yedekler: yalnız admin
    match /backups/{id} {
      allow read, write: if isAdmin();
    }
    // Diğer her şey kapalı
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
